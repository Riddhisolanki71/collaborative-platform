# Copy to .env and fill in for local development, or export these directly in
# your shell / IDE run configuration / deployment platform's env var settings.
# Spring Boot does not auto-load a .env file, so either:
#   export $(grep -v '^#' .env | xargs) && mvn spring-boot:run
# or set these as real environment variables another way before running.
# Every variable below has a safe local-dev default in application.yml except
# JWT_SECRET, which you should always set explicitly outside of local dev.

# --- Database ---------------------------------------------------------------
# Defaults to an in-memory H2 database if unset (zero setup, data lost on restart).
# Point these at Postgres for anything beyond quick local testing:
DB_URL=jdbc:postgresql://localhost:5432/collabplatform
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=collabplatform
DB_PASSWORD=change-me
DDL_AUTO=update
SHOW_SQL=false

# --- Auth --------------------------------------------------------------------
# MUST be a long random string in any real deployment. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-this-dev-only-secret-please-override-me-1234567890
JWT_EXPIRATION_MS=86400000

# --- CORS / frontend origin ---------------------------------------------------
# Comma-separated list of origins allowed to call the API / open the WebSocket.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Server --------------------------------------------------------------------
SERVER_PORT=8080
LOG_LEVEL=INFO
